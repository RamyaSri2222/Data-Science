        "import numpy as np\n",
        "from sklearn.datasets import load_digits\n",
        "from sklearn.model_selection import cross_val_score\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "df=load_digits()\n",
        "a= LogisticRegression(solver=\"lbfgs\",max_iter=30000)\n",
        "svm=SVC()\n",
        "tarin= RandomForestClassifier(n_estimators=40)\n",
        "sco1=cross_val_score(a,df.data,df.target,cv=3)\n",
        "sco2=cross_val_score(svm,df.data,df.target,cv=3)\n",
        "sco3=cross_val_score(tarin,df.data,df.target,cv=3)\n",
        "print(np.average(sco1))\n",
        "print(np.average(sco2))\n",
        "print(np.average(sco3))\n",
        "\n"
      ],
