        "import pickle\n",
        "class Students:\n",
        "  def __init__(self,eno,ename,esalary):\n",
        "    self.eno=eno\n",
        "    self.ename=ename\n",
        "    self.esalary=esalary\n",
        "  def display(self):\n",
        "      print(\"Number is:\",self.eno)\n",
        "      print(\"Name is:\",self.ename)\n",
        "      print(\"salary is:\",self.esalary)\n",
        "with open(\"emp.dat\",\"wb\") as f:\n",
        "    obj=Students(123,\"Ramyasri\",50000)\n",
        "    pickle.dump(obj,f)\n",
        "    print(\"Pickling Employee Object Completed\")\n",
        "with open(\"emp.dat\",\"rb\") as f:\n",
        "    obj=pickle.load(f)\n",
        "    print(\"Printing Employee infomation after unpickling\")\n",
        "    obj.display()"
      ]
    }
  ]
